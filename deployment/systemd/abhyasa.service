[Unit]
Description=Abhyāsa landing page (Next.js production server)
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/abhyasa
ExecStart=/usr/bin/pnpm start
Restart=on-failure
RestartSec=5
Environment=NODE_ENV=production
Environment=PORT=3030

[Install]
WantedBy=multi-user.target
