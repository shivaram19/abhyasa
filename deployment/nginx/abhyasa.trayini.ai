# Nginx configuration for abhyasa.trayini.ai
# Serves the statically exported Abhyāsa landing page.
# Run `certbot --nginx -d abhyasa.trayini.ai` after DNS resolves to this host.

server {
    listen 80;
    listen [::]:80;
    server_name abhyasa.trayini.ai;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name abhyasa.trayini.ai;

    root /var/www/abhyasa.trayini.ai;
    index index.html;

    ssl_certificate /etc/letsencrypt/live/abhyasa.trayini.ai/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/abhyasa.trayini.ai/privkey.pem;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers off;
    ssl_session_timeout 1d;
    ssl_session_cache shared:SSL:50m;

    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;

    server_tokens off;

    gzip on;
    gzip_vary on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml;

    # Next.js static export uses clean URLs; try file, .html variant, then directory index.
    location / {
        try_files $uri $uri.html $uri/ =404;
    }

    error_page 404 /404.html;
    location = /404.html {
        internal;
    }

    # Long cache for hashed assets under /_next/static
    location /_next/static {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }
}
